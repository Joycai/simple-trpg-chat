# Simple TRPG Chat — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Or run: bash setup.sh (Linux/macOS) or setup.bat (Windows)

# ============================================================
# Required
# ============================================================

# Auth.js secret — used to encrypt session tokens and cookies.
# Generate: openssl rand -hex 32
AUTH_SECRET=

# Auth.js base URL — required for production mode (pnpm build && pnpm start)
# For local development, use http://localhost:3000
AUTH_URL=http://localhost:3000

# ============================================================
# Optional — AI Bot (only needed for AI features)
# ============================================================

# AI API encryption key (AES-256-GCM). Host config stored encrypted.
# Generate: openssl rand -hex 32
# AI_ENCRYPTION_KEY=
